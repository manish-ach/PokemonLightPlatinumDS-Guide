# Copy to .env and change every value before deploying.
# The admin account is created from these on first boot.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=use-a-long-random-password
# Sign JWT session cookies. Use a long random string (e.g. `openssl rand -hex 32`).
JWT_SECRET=change-me-to-a-long-random-secret
# Where the SQLite database and uploaded images live (mounted as volumes in Docker).
DATABASE_PATH=data/data.db
UPLOAD_DIR=uploads
# Set to 'production' when serving over HTTPS so session cookies are marked Secure.
NODE_ENV=development
