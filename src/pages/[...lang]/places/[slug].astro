---
import { withLangs, t, rich, placeName, itemName, tmLabel, typeName } from '../../../lib/i18n.js';
import Base from '../../../layouts/Base.astro';
import PageHead from '../../../components/PageHead.astro';
import Mon from '../../../components/Mon.astro';
import Shot from '../../../components/Shot.astro';
import Note from '../../../components/Note.astro';
import ItemDialog from '../../../components/ItemDialog.astro';
import Stepper from '../../../components/Stepper.astro';
import DiskSolution from '../../../components/DiskSolution.astro';
import { placeText, REACHABLE, placeSlug, href, slug, WILD_BY_PLACE, GYM_AT, PHENOM_BY_PLACE, OUTBREAK_BY_PLACE, LOCATION_NOTES, PLACE_SHOTS, PLACE_EXTRA, ITEMS, ITEMS_AT, DEXNAV, WALK, PLACE_INSIDE, PLACE_CONTAINS, placePath, itemKey, pocketOf, itemSlug, pic, dim, optSources } from '../../../lib/data.js';

export function getStaticPaths() {
  return withLangs(REACHABLE.map((p) => ({ params: { slug: placeSlug(p.name) }, props: { place: p } })));
}
const { place } = Astro.props;
const wild = WILD_BY_PLACE.get(place.name);
const gym = GYM_AT.get(place.name);
const ph = PHENOM_BY_PLACE.get(place.name) || [];
const ob = OUTBREAK_BY_PLACE.get(place.name) || [];
const notes = LOCATION_NOTES.get(place.name);
const shot = PLACE_SHOTS[place.name];
const extra = PLACE_EXTRA[place.name];
const items = ITEMS_AT(place.name);
const icon = (i) => i.sprite || (i.localIcon ? href(`pictures/items/${i.localIcon}`) : null);
const itemPath = (i) => href(`items/${pocketOf(i)}/#${itemSlug(i)}`);
const itemHref = (name) => { const i = ITEMS.find((x) => itemKey(x.name) === itemKey(name)); return i ? itemPath(i) : null; };

/* the pictures for the right-hand column: one DexNav capture per method,
   then whatever else has been photographed here */
const nav = DEXNAV[place.name] || {};
/* "East island — Grass" is a sub-area and a method; group the rows by
   sub-area so a big place reads as a few short lists, not one long one */
const parseHow = (how) => { const i = how.indexOf(' — '); return i < 0 ? { area: null, how } : { area: how.slice(0, i), how: how.slice(i + 3) }; };
const groups = [];
for (const g of wild?.methods || []) {
  const { area, how } = parseHow(g.how);
  let grp = groups.find((x) => x.area === area);
  if (!grp) groups.push(grp = { area, rows: [] });
  grp.rows.push({ ...g, short: how });
}
/* each picture knows its own sub-area, the short name for its tab and the full
   caption, all in the page's language */
const views = [
  ...(wild ? wild.methods.filter((g) => nav[g.how]).map((g) => { const { area, how } = parseHow(g.how); const full = area ? `${t(area)} — ${t(how)}` : t(how);
    return { id: slug(g.how), area, tab: t(how), label: area ? `${t(area)} · ${t(how)}` : t(how), src: nav[g.how], caption: `DexNav — ${full}` }; }) : []),
  ...(shot ? [{ id: 'seen', area: null, tab: t('Seen here'), label: t('Seen here'), src: shot[0], caption: placeText(shot[1]) }] : []),
];
const areas = groups.filter((g) => g.area).map((g) => g.area);
/* an area named only in punctuation ("???") still needs an id to switch to */
const areaId = (a) => slug(a) || 'unknown';
const segmented = areas.length > 1;
const isR412 = place.name === 'Route 412';
/* previous and next stop on the walk, by your numbering */
const wi = WALK.indexOf(place.name);
const prevP = wi > 0 ? WALK[wi - 1] : null, nextP = wi >= 0 && wi < WALK.length - 1 ? WALK[wi + 1] : null;
const stop = (name) => { const o = WILD_BY_PLACE.get(name)?.order; return o == null ? '' : String(o).replace(/\.5$/, '½'); };
const outer = PLACE_INSIDE[place.name];
const inner = PLACE_CONTAINS.get(place.name) || [];
---
<Base title={placeName(place.name)} current="places" description={t('{place} in Pokémon Light Platinum DS — what lives there and what to pick up.', { place: placeName(place.name) })}>
  <PageHead title={placeName(place.name)} back={{ href: href('places/'), label: t('Places') }}>
    {!place.name.toLowerCase().includes(String(place.kind).toLowerCase()) && <p class="count">{t(place.kind)}</p>}
    {outer && <a class="btn btn--quiet btn--sm" href={placePath(outer)}>{t('In {place}', { place: placeName(outer) })}</a>}
    {inner.map((n) => <a class="btn btn--quiet btn--sm" href={placePath(n)}>{t('Inside: {place}', { place: placeName(n) })}</a>)}
    {(prevP || nextP) && <Stepper label={t('Neighbouring places on the walk')}
      prev={prevP ? { href: placePath(prevP), name: placeName(prevP), num: stop(prevP) } : { href: href('places/'), name: t('All places') }}
      next={nextP ? { href: placePath(nextP), name: placeName(nextP), num: stop(nextP) } : { href: href('places/'), name: t('All places') }} />}
  </PageHead>

  {place.name === 'Pantem Cave' && (
    <DiskSolution title={t('Disk puzzle solution — lake trio')} hint={t('Tap to see how the disk should end up.')}
      src="pantem_cave_disk.webp" caption={t('Disk puzzle, solved')} place={t('Pantem Cave')}>
      <p set:html={rich('The disk room opens only after you finish this version: Cynthia waits in the once-locked house in <1>Pantem Town</1>, and talking to her grants entry. Solving the disk frees <2>the lake trio</2>, who then roam the routes.', { 1: `<a href="${placePath('Pantem Town')}">`, 2: `<a href="${href('quests/#the-lake-trio')}">` })} />
    </DiskSolution>
  )}

  <div class:list={['split', { 'split--media': views.length > 0 }]}>
    <div class="split__text">
      {(gym || ph.length > 0 || ob.length > 0 || notes?.notes || extra) && (
        <dl class="kv facts">
          {gym && <div><dt>{t('Gym')}</dt><dd><a href={href(`gyms/${slug(gym.city)}/`)}>{t(gym.badge)}</a> — {t('Leader')} {gym.leader}, {gym.types.map((ty) => typeName(ty)).join(' · ')}, {t('lv')} {gym.levels}</dd></div>}
          {ph.map((x) => <div><dt>{t('Phenomena')}</dt><dd><Mon name={x.name} nat={x.nat} /> <span class="small muted" set:html={`${t(x.kind).toLowerCase()} · ${rich('needs the <1>Phenomenal medal</1>', { 1: `<a href="${href('medals/#phenomenal')}">` })}`} /></dd></div>)}
          {ob.map((x) => <div><dt>{t('Outbreak')}</dt><dd><Mon name={x.name} nat={x.nat} /> <span class="small muted">{t('mass outbreak · after the Groment City gym, announced in the PDA')}</span></dd></div>)}
          {notes?.notes && <div><dt>{t('Notes')}</dt><dd>{t(notes.notes)}</dd></div>}
          {extra && <div><dt>{t('Also')}</dt><dd>{t(extra)}</dd></div>}
        </dl>
      )}

      {wild ? (
        <section class="block">
          <h2>{t('Wild Pokémon')} <span class="small muted">{t('from the game’s encounter tables')}</span></h2>
          {wild.note && <p class="small muted">{t(wild.note)}</p>}
          {segmented && (
            <div class="seg" role="group" aria-label={t('Part of the area')}>
              {areas.map((a, i) => <button type="button" class="seg__btn" data-area={areaId(a)} aria-pressed={i === 0 ? 'true' : 'false'}>{t(a)}</button>)}
            </div>
          )}
          {groups.map((grp, i) => (
            <div class="area" data-area-pane={grp.area ? areaId(grp.area) : ''} hidden={segmented && i !== 0}>
              <dl class="kv">
                {grp.rows.map((g) => (
                  <div>
                    <dt>{nav[g.how] ? <button type="button" class="how" data-view={slug(g.how)} aria-pressed="false">{t(g.short)}</button> : t(g.short)}</dt>
                    <dd class="mons">{g.mons.map((m) => <Mon name={m.name} nat={m.nat} form={m.form} />)}</dd>
                  </div>
                ))}
              </dl>
            </div>
          ))}
        </section>
      ) : (
        <p class="empty">{t('No wild Pokémon listed for {place} yet.', { place: placeName(place.name) })}</p>
      )}

      {items.length > 0 && (
        <section class="block">
          <h2>{t('Items here')} <span class="small muted num">{items.length}</span></h2>
          <ul class="finds cells">
            {items.map(({ item, detail }) => (
              <li>
                <a class="find" href={itemPath(item)} data-item={itemSlug(item)}>
                  <span class="find__icon">{icon(item) ? <img src={icon(item)} alt="" width="32" height="32" loading="lazy" decoding="async" /> : <i aria-hidden="true"></i>}</span>
                  <span class="find__name">{item.tm && item.name !== item.tm ? `${tmLabel(item.tm)} ` : ''}{itemName(item.name, item.tm)}</span>
                  {detail && <span class="find__where small muted">{detail.split(' · ').map((d) => placeText(d)).join(' · ')}</span>}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      {isR412 && (
        <section class="block prose">
          <h2>{t('Working the route')}</h2>
          <p>{t('Route 412 is the densest pickup route. Work the eastern ledges first; the fossil choice is one-time and the Everstone is easy to walk past.')}</p>
          <h3>{t('The eastern ledges')}</h3>
          <p set:html={rich('<1>Thick Club</1> sits behind the first ledge drop. It is a Marowak item, so it is worth collecting even if you have no Cubone yet.', { 1: `<a href="${itemHref('Thick Club')}">` })} />
          <Shot src="ItemLocations/ThickClubRoute412.jpeg" title={t('Thick Club')} place={t('Route 412 — eastern ledges')} />
          <Note kind="warn" title={t('Missable — Sail Fossil or Jaw Fossil, at random')}>
            <p>{t('He gives you one of the two at random, and you cannot come back for the other on this save. Jaw Fossil gives Tyrunt; Sail Fossil gives Amaura.')}</p>
            <p set:html={rich('<1>Timed.</1> Talking to him starts a one-day countdown. He wants a drink — hand over a Lemonade, Fresh Water or Soda Pop before the day is out. Let it lapse and he leaves with both fossils. Buy the drink <2>before</2> you talk to him.', { 1: '<b>', 2: '<em>' })} />
          </Note>
          <Shot src="ItemLocations/SailOrJawFossilRoute412.jpeg" title={t('Sail / Jaw Fossil')} place={t('Route 412 — the choice')} />
          <h3>{t('TMs on the route')}</h3>
          <p>{t('TM37 Sandstorm is a field pickup. TM05 Roar is held by the Ace Trainer (F) and only changes hands after you beat her.')}</p>
          <div class="shots">
            <Shot src="Tm/TM37SandstormRoute412.jpeg" title={t('TM37 Sandstorm')} place={t('Route 412')} />
            <Shot src="Tm/TM05RoarRoute412.jpeg" title={t('TM05 Roar')} place={t('Ace Trainer (F) · Route 412')} />
          </div>
          <h3>{t('Held items worth the detour')}</h3>
          <p set:html={rich('<1>Bright Powder</1> and the <2>Everstone</2> are both on this route. The Everstone matters more than usual here — several evolution levels differ from vanilla.', { 1: `<a href="${itemHref('Bright Powder')}">`, 2: `<a href="${itemHref('Everstone')}">` })} />
          <div class="shots">
            <Shot src="ItemLocations/BrightPowderROute412.jpeg" title={t('Bright Powder')} place={t('Route 412')} />
            <Shot src="ItemLocations/EveStoneRoute412.jpeg" title={t('Everstone')} place={t('Route 412')} />
          </div>
          <h3>{t('Checklist')}</h3>
          <ul class="checks">
            {['Thick Club — eastern ledges', 'Pick your fossil (one only)', 'TM37 Sandstorm', 'Beat Ace Trainer (F) for TM05 Roar', 'Bright Powder and Everstone', 'Harvest the Sitrus / Ganlon tree'].map((task, i) => (
              <li><label><input type="checkbox" data-check={`r412-${i}`} /> {t(task)}</label></li>
            ))}
          </ul>
          <p class="small muted">{t('Ticks are saved on this device only.')}</p>
        </section>
      )}
    </div>

    {views.length > 0 && (
      <aside class="split__media" aria-label={t('Pictures')}>
        <div class="viewer" data-viewer>
          {views.length > 1 && (
            <div class="viewer__tabs" role="tablist">
              {views.map((v, i) => { const a = v.area; return (
                <button type="button" role="tab" class="viewer__tab" data-view={v.id} data-tab-area={a ? areaId(a) : ''} aria-selected={i === 0 ? 'true' : 'false'} hidden={segmented && a && a !== areas[0]}>{a ? v.tab : v.label}</button>
              ); })}
            </div>
          )}
          {views.map((v, i) => {
            const [w, h] = dim(v.src); const srcset = optSources(v.src);
            return (
              <figure class="viewer__pane" data-pane={v.id} data-label={v.label} hidden={i !== 0}>
                <picture>
                  {srcset.length > 0 && <source type="image/webp" sizes="(max-width: 900px) 92vw, 420px" srcset={srcset.join(', ')} />}
                  <img src={pic(v.src)} width={w} height={h} alt={`${v.caption}, ${placeName(place.name)}`} loading="eager" decoding="async" />
                </picture>
                <figcaption><b>{v.caption}</b><span>{placeName(place.name)}</span></figcaption>
              </figure>
            );
          })}
        </div>
      </aside>
    )}
  </div>

  {items.length > 0 && <ItemDialog items={items.map((x) => x.item)} />}

  <style>
    .split { display: grid; gap: var(--sp-6); align-items: start; }
    @media (min-width: 900px) { .split--media { grid-template-columns: minmax(0, 1fr) 420px; } }
    .split__text { min-width: 0; }
    .split__media { min-width: 0; }
    /* the picture stays put while the text beside it scrolls */
    @media (min-width: 900px) { .split__media { position: sticky; top: calc(var(--bar-h) + var(--sp-4)); } }
    @media (max-width: 899px) { .split__media { order: -1; } }
    .viewer { border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); overflow: hidden; }
    .viewer__tabs { display: flex; flex-wrap: wrap; gap: 2px; padding: var(--sp-1); border-bottom: 1px solid var(--line); background: var(--surface-2); }
    .viewer__tab { min-height: 44px; padding: 2px var(--sp-3) 0; border: 0; border-radius: var(--radius-sm); background: transparent; color: var(--ink-2); font: inherit; font-size: var(--text-sm); font-weight: 600; cursor: pointer; }
    .viewer__tab:hover { background: var(--surface); color: var(--ink); }
    .viewer__tab[aria-selected="true"] { background: var(--accent); color: var(--on-accent); font-weight: 700; }
    .seg { display: flex; flex-wrap: wrap; gap: 2px; margin-bottom: var(--sp-4); padding: 3px; border: 1px solid var(--line-strong); border-radius: var(--radius-md); background: var(--surface); width: fit-content; max-width: 100%; }
    .seg__btn { min-height: 44px; padding: 2px var(--sp-3) 0; border: 0; border-radius: var(--radius-sm); background: transparent; color: var(--ink-2); font: inherit; font-size: var(--text-sm); font-weight: 600; cursor: pointer; }
    .seg__btn:hover { color: var(--ink); background: var(--surface-2); }
    .seg__btn[aria-pressed="true"] { background: var(--accent); color: var(--on-accent); font-weight: 700; }
    .area[hidden] { display: none; }
    .area__h { display: none; }
    .viewer__tab[hidden] { display: none; }
    .viewer__pane { margin: 0; }
    .viewer__pane[hidden] { display: none; }
    /* every capture sits in the same 4:3 frame, whatever its pixel size */
    .viewer__pane picture { display: block; aspect-ratio: 4 / 3; background: var(--surface-2); }
    .viewer__pane img { display: block; width: 100%; height: 100%; object-fit: contain; image-rendering: pixelated; }
    .viewer__pane figcaption { display: flex; justify-content: space-between; gap: var(--sp-3); padding: var(--sp-2) var(--sp-3); font-size: var(--text-sm); border-top: 1px solid var(--line); }
    .viewer__pane figcaption span { color: var(--ink-3); }
    /* each method is a ruled row: the method name is the key, the Pokémon the answer */
    .block .kv { gap: 0; }
    .block .kv > div { padding-block: var(--sp-2); border-bottom: 1px solid var(--line); }
    .block .kv > div:last-child { border-bottom: 0; }
    .block .kv dt { color: var(--ink); }
    .how { border: 0; background: none; padding: 0; font: inherit; color: inherit; cursor: pointer; text-align: left; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.18em; }
    .how:hover { text-decoration-thickness: 2px; }
    /* the method whose capture is showing is marked the way the current page is */
    .how[aria-pressed="true"] { background: var(--accent); color: var(--on-accent); text-decoration: none; padding: 1px 6px 0; margin-left: -6px; border-radius: var(--radius-sm); }
    @media (pointer: coarse) { .how { min-height: 44px; display: inline-flex; align-items: center; } }
    /* what is lying around here: one sheet, a ruled cell per item */
    .finds { list-style: none; --cell: 230px; }
    .finds > li { box-shadow: 1px 0 0 var(--line), 0 1px 0 var(--line); display: grid; }
    .find { display: grid; grid-template-columns: 36px minmax(0, 1fr); column-gap: var(--sp-2); align-content: center; align-items: center; padding: var(--sp-2) var(--sp-3); text-decoration: none; color: var(--ink); min-height: 60px; transition: background var(--t-fast) var(--ease); }
    .find:hover { background: var(--surface-2); }
    .find:focus-visible { border-radius: 0; outline-offset: -2px; box-shadow: inset 0 0 0 5px var(--accent); }
    .find__icon { width: 36px; height: 36px; display: grid; place-items: center; grid-row: span 2; }
    .find__icon img { image-rendering: pixelated; }
    .find__icon i { width: 12px; height: 12px; border: 1px solid var(--line-strong); border-radius: 3px; }
    .find__name, .find__where { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; line-height: 1.3; }
    .find__name { font-weight: 700; font-size: var(--text-sm); }
    .prose h3 { margin-top: var(--sp-6); }
    .checks { list-style: none; display: grid; gap: var(--sp-1); }
    .checks label { display: flex; gap: var(--sp-2); align-items: center; min-height: 44px; cursor: pointer; }
    .checks input { width: 20px; height: 20px; accent-color: var(--accent-ink); flex: none; }
  </style>

  <script>
    const init = () => {
      for (const box of document.querySelectorAll('[data-check]')) {
        const k = 'check:' + box.dataset.check;
        try { box.checked = localStorage.getItem(k) === '1'; } catch (e) {}
        box.addEventListener('change', () => { try { localStorage.setItem(k, box.checked ? '1' : '0'); } catch (e) {} });
      }
      /* method names in the list and tabs on the viewer pick the same picture */
      /* not every place has pictures, but its area tabs must still switch */
      const seg = document.querySelector('.seg');
      const viewer = document.querySelector('[data-viewer]');
      const root = viewer || seg;
      if (!root || root.dataset.wired) return;
      root.dataset.wired = '1';
      const panes = viewer ? [...viewer.querySelectorAll('[data-pane]')] : [];
      const show = (id) => {
        if (!viewer) return;
        panes.forEach((p) => { p.hidden = p.dataset.pane !== id; });
        viewer.querySelectorAll('[role=tab]').forEach((t) => t.setAttribute('aria-selected', String(t.dataset.view === id)));
        document.querySelectorAll('.how').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.view === id)));
      };
      document.querySelectorAll('[data-view]').forEach((b) => b.addEventListener('click', () => show(b.dataset.view)));
      /* the segmented control narrows both the list and the picture tabs to one part of the area */
      document.querySelectorAll('.seg__btn').forEach((b) => b.addEventListener('click', () => {
        const a = b.dataset.area;
        document.querySelectorAll('.seg__btn').forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
        document.querySelectorAll('[data-area-pane]').forEach((p) => { p.hidden = p.dataset.areaPane !== a; });
        if (!viewer) return;
        const tabs = [...viewer.querySelectorAll('[role=tab]')];
        tabs.forEach((t) => { t.hidden = !!t.dataset.tabArea && t.dataset.tabArea !== a; });
        const first = tabs.find((t) => t.dataset.tabArea === a) || tabs.find((t) => !t.hidden);
        if (first) show(first.dataset.view);
      }));
    };
    init();
    document.addEventListener('astro:page-load', init);
  </script>
</Base>
