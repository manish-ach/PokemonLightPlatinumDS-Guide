---
import { langPaths, t, itemName, monName } from '../../lib/i18n.js';
export function getStaticPaths() { return langPaths(); }
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Shot from '../../components/Shot.astro';
import { QUESTS, slug, href, pic, SPRITE, SPRITE_ITEM, NAT_OF, SPECIES_BY_NAME, spPath, ITEM_BY_KEY, itemKey, MEDALS, medalIcon, pocketOf, itemSlug, placeText } from '../../lib/data.js';
const side = QUESTS.filter((q) => q.kind === 'sidequest');
const gifts = QUESTS.filter((q) => q.kind === 'gift');
const threads = QUESTS.filter((q) => q.kind === 'thread');
/* a quest's corner art, named by what it is: an item or medal from the
   site's own data (so it matches the Items and Medals pages), else a file */
const itemPage = (name) => { const i = ITEM_BY_KEY.get(itemKey(name)); return i ? href(`items/${pocketOf(i)}/#${itemSlug(i)}`) : null; };
/* items missing from the cartridge's table (Cover and Plume Fossil) still get PokéAPI's sprite */
const itemArt = (name) => { const i = ITEM_BY_KEY.get(itemKey(name)); return i ? i.sprite || (i.localIcon ? pic(`items/${i.localIcon}`) : null) : SPRITE_ITEM(slug(name)); };
const medalArt = (name) => { const m = MEDALS.find((x) => x.name === name); const f = m && medalIcon(m); return f ? pic(`MedalIcons/${f}`) : null; };
const art = (q) => q.item ? itemArt(q.item) : q.medal ? medalArt(q.medal) : q.icon ? pic(q.icon) : q.itemSprite ? SPRITE_ITEM(q.itemSprite) : null;
const SECTIONS = [
  [null, null, side],
  ['One-off gifts', 'Just talk to them — no task attached.', gifts],
  ['Where v0.2.2 leaves you', 'After Dardusk City the story stops, and three people call at your house in Yellow Town to set up what comes next. None can be followed further in this version.', threads],
];
const foot = (q) => q.who ? `${t(q.who)} · ${placeText(q.where)}` : placeText(q.where);
---
<Base title={t('Quests')} current="quests" description={t('Optional errands around Zhery, and the story threads v0.2.2 leaves open.')}>
  <PageHead title={t('Quests')} note={t('Optional errands people offer you around Zhery.')} />

  {/* a ledger: the errand, what it asks, where it starts. The row opens the full text. */}
  {SECTIONS.map(([title, intro, list]) => (
    <section class:list={[{ group: !!title }]}>
      {title && <h2>{t(title)}</h2>}
      {intro && <p class="small muted threads-p">{t(intro)}</p>}
      <ul class="ledger" data-questgrid>
        {list.map((q) => (
          <li id={slug(q.name)}>
            <button type="button" class="ledger__row quest" data-quest={slug(q.name)} aria-haspopup="dialog">
              <span class="ledger__name">{q.name}{q.urgent && <span class="pill quest__pill">{t('Timed')}</span>}{q.warn && <span class="pill quest__pill">Bug ≤ v0.2.3</span>}</span>
              <span class="ledger__meta quest__short">{t(q.short ?? q.desc)}</span>
              <span class="ledger__end quest__end">
                <span class="quest__where">{foot(q)}</span>
                {q.mons ? <span class="quest__art" aria-hidden="true">{q.mons.slice(0, 3).map((m) => <img src={SPRITE(NAT_OF.get(m))} alt="" width="40" height="40" loading="lazy" decoding="async" />)}</span>
                  : art(q) && <span class="quest__art" aria-hidden="true"><img src={art(q)} alt="" width="32" height="32" loading="lazy" decoding="async" /></span>}
              </span>
            </button>
          </li>
        ))}
      </ul>
    </section>
  ))}

  <dialog class="dialog" id="questdialog" aria-labelledby="qdl-title">
    <div class="dialog__bar"><p>{t('Quest')}</p><button type="button" class="iconbtn" data-close aria-label={t('Close')}><svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 3l10 10M13 3L3 13"/></svg></button></div>
    <div class="dialog__body" id="qdl-body"></div>
  </dialog>

  {/* each quest's full text, rendered at build time and copied into the dialog */}
  {QUESTS.map((q) => (
    <template data-quest-detail={slug(q.name)}>
      <div class="dialog__head">
        {!q.mons && art(q) && <img src={art(q)} alt="" />}
        <div><h2 id="qdl-title">{q.name}</h2><p class="small muted">{foot(q)}</p></div>
      </div>
      {q.steps ? (
        <>
          <p>{t(q.short)}</p>
          <p class="dialog__label">{t('Steps')}</p>
          <ol class="quest__steps">{q.steps.map((s) => <li>{t(s)}</li>)}</ol>
        </>
      ) : <p>{t(q.desc)}</p>}
      {q.warn && <p class="quest__warn">{t(q.warn)}</p>}
      {q.reward && <><p class="dialog__label">{t('Reward')}</p><p>{t(q.reward)}</p></>}
      {(q.rewardItems || (q.item ? [q.item] : [])).length > 0 && (
        <div class="quest__items">{(q.rewardItems || [q.item]).map((n) => (
          <a class="quest__item" href={itemPage(n)}>{itemArt(n) ? <img src={itemArt(n)} alt="" width="32" height="32" /> : <i aria-hidden="true"></i>}<span>{itemName(ITEM_BY_KEY.get(itemKey(n))?.name || n)}</span></a>
        ))}</div>
      )}
      {q.mons && (
        <>
          <p class="dialog__label">Pokémon</p>
          <div class="quest__monrow">{q.mons.map((m) => { const sp = SPECIES_BY_NAME.get(m); return (
            <a class="quest__mon" href={sp ? spPath(sp) : undefined}><img src={SPRITE(NAT_OF.get(m))} alt="" width="48" height="48" />{monName(m)}</a>
          ); })}</div>
        </>
      )}
      {q.shot && <Shot src={q.shot[0]} title={q.name} place={q.shot[1]} />}
      {q.links && <p>{q.links.map(([label, to]) => <a href={href(to)}>{t(label)} →</a>)}</p>}
    </template>
  ))}

  <style>
    .threads-p { margin: calc(-1 * var(--sp-1)) 0 var(--sp-3); max-width: var(--measure); }
    .quest { grid-template-columns: minmax(0, 15rem) minmax(0, 1fr) minmax(0, 17rem); }
    .quest__pill { --pill: var(--warn); --pill-soft: var(--warn-soft); }
    .quest__short { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .quest__end { justify-self: stretch; justify-content: space-between; }
    .quest__where { min-width: 0; }
    .quest__art { display: flex; flex: none; }
    .quest__art img { image-rendering: pixelated; object-fit: contain; }
    .quest__art img + img { margin-left: -10px; }
    @media (max-width: 719px) { .quest { grid-template-columns: minmax(0, 1fr); } }
    .quest__warn { border: 1px solid var(--warn); background: var(--warn-soft); border-radius: var(--radius); padding: var(--sp-2) var(--sp-3); font-size: var(--text-sm); }
    .quest__steps { padding-left: 1.3em; display: grid; gap: var(--sp-1); font-size: var(--text-sm); }
    .quest__items { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: var(--sp-2); }
    .quest__item { display: flex; align-items: center; gap: var(--sp-2); font-size: var(--text-sm); font-weight: 600; border: 1px solid var(--line); border-radius: var(--radius-md); padding: var(--sp-1) var(--sp-2); text-decoration: none; color: inherit; min-width: 0; }
    .quest__item[href]:hover { border-color: var(--ink-2); }
    .quest__item img { image-rendering: pixelated; flex: none; }
    .quest__item i { width: 32px; height: 32px; flex: none; }
    .quest__item span { min-width: 0; overflow-wrap: anywhere; }
    .quest__monrow { display: flex; flex-wrap: wrap; gap: var(--sp-2); }
    .quest__mon { display: grid; justify-items: center; font-size: var(--text-sm); font-weight: 600; border: 1px solid var(--line); border-radius: var(--radius-md); padding: var(--sp-1) var(--sp-3) var(--sp-2); text-decoration: none; color: inherit; }
    .quest__mon:hover { border-color: var(--ink-2); }
    .quest__mon img { image-rendering: pixelated; }
  </style>

  <script>
    const init = () => {
      const dlg = document.getElementById('questdialog');
      if (!dlg || dlg.dataset.wired) return;
      dlg.dataset.wired = '1';
      const body = document.getElementById('qdl-body');
      const show = (key, push = true) => {
        const t = document.querySelector(`template[data-quest-detail="${key}"]`);
        if (!t) return;
        body.replaceChildren(t.content.cloneNode(true));
        if (!dlg.open) dlg.showModal();
        if (push) history.replaceState(null, '', '#' + key);
      };
      document.querySelectorAll('[data-questgrid]').forEach((g) => g.addEventListener('click', (e) => {
        const b = e.target.closest('[data-quest]'); if (b) show(b.dataset.quest);
      }));
      dlg.querySelector('[data-close]').addEventListener('click', () => dlg.close());
      dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
      dlg.addEventListener('close', () => history.replaceState(null, '', location.pathname));
      if (location.hash) show(location.hash.slice(1), false);
    };
    init();
    document.addEventListener('astro:page-load', init);
  </script>
</Base>
