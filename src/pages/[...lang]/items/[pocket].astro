---
import Base from '../../../layouts/Base.astro';
import PageHead from '../../../components/PageHead.astro';
import ItemDialog from '../../../components/ItemDialog.astro';
import { POCKETS, inPocket, href, itemSlug } from '../../../lib/data.js';
import { withLangs, t, rich, itemName, tmLabel } from '../../../lib/i18n.js';

export function getStaticPaths() {
  return withLangs(POCKETS.map((p) => ({ params: { pocket: p.id }, props: { pocket: p } })));
}
const { pocket } = Astro.props;
const list = inPocket(pocket.id);
const icon = (i) => i.sprite || (i.localIcon ? href(`pictures/items/${i.localIcon}`) : null);
---
<Base title={t(pocket.label)} current="items" description={t('{pocket} in Pokémon Light Platinum DS and where each is found.', { pocket: t(pocket.label) })}>
  <PageHead title={t(pocket.label)} back={{ href: href('items/'), label: t('Items') }}>
    <label class="field">
      <svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="9" cy="9" r="6"/><path d="m14 14 4 4"/></svg>
      <input type="search" id="itemsearch" placeholder={t('Search {pocket}…', { pocket: t(pocket.label).toLowerCase() })} aria-label={t('Search this pocket')} />
    </label>
    <p class="count"><output id="itemcount">{list.length}</output> {t('of')} {list.length}</p>
  </PageHead>
  {pocket.id === 'machines' && <p class="small muted lead" set:html={rich('TMs and HMs with a known pickup or shop are marked <1>obtainable</1>.', { 1: '<b>' })} />}

  <div class="cells" id="itemgrid">
    {list.map((i) => (
      <button type="button" class="cell item" id={itemSlug(i)} data-item={itemSlug(i)} data-q={`${i.tm || ''} ${tmLabel(i.tm) || ''} ${i.name} ${itemName(i.name, i.tm)} ${(i.locations || []).join(' ')}`.toLowerCase()}>
        <span class="item__slot">{icon(i) ? <img src={icon(i)} alt="" width="40" height="40" loading="lazy" decoding="async" /> : <i aria-hidden="true"></i>}</span>
        <span class="item__name">{i.tm && i.name !== i.tm && <span class="num muted">{tmLabel(i.tm)} </span>}{itemName(i.name, i.tm)}</span>
        {i.tm && i.confirmed && <span class="item__tag">{t('obtainable')}</span>}
        {i.locations.length > 1 && <span class="item__n num">×{i.locations.length}</span>}
      </button>
    ))}
  </div>
  <p class="empty" id="itemempty" hidden>{t('Nothing here matches.')}</p>

  <ItemDialog items={list} hash={true} />

  <script>
    const init = () => {
      const grid = document.getElementById('itemgrid');
      if (!grid || grid.dataset.wired) return;
      grid.dataset.wired = '1';
      const box = document.getElementById('itemsearch'), out = document.getElementById('itemcount'), empty = document.getElementById('itemempty');
      const items = [...grid.querySelectorAll('[data-item]')];
      box?.addEventListener('input', () => {
        const q = box.value.trim().toLowerCase(); let n = 0;
        for (const i of items) { const ok = !q || i.dataset.q.includes(q); i.hidden = !ok; if (ok) n++; }
        out.textContent = String(n); empty.hidden = n > 0;
      });
    };
    init();
    document.addEventListener('astro:page-load', init);
  </script>
</Base>
