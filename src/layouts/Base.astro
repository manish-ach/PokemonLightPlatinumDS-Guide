---
import '@fontsource-variable/overpass';
import '@fontsource-variable/overpass-mono';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { href, asset, BASE } from '../lib/data.js';
import { LINES, lineOf } from '../lib/nav.js';
import { t, rich, isEs, clientDict } from '../lib/i18n.js';

interface Props { title: string; description?: string; current?: string; }
const { title, description = 'A field guide to Pokémon Light Platinum DS.', current = '' } = Astro.props;
const line = lineOf(current);
const es = isEs();
/* this page in each language, for the switch in the bar */
const here = Astro.url.pathname.replace(BASE, '').replace(/^\/es(?=\/|$)/, '').replace(/^\//, '');
const enUrl = asset(here), esUrl = asset(`es/${here}`);
---
<!doctype html>
<html lang={es ? 'es' : 'en'}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title} · Light Platinum DS</title>
  <meta name="description" content={description} />
  <link rel="alternate" hreflang="en" href={new URL(enUrl, Astro.site)} />
  <link rel="alternate" hreflang="es" href={new URL(esUrl, Astro.site)} />
  <meta name="theme-color" content="#1a2236" />
  <link rel="icon" href={href('favicon.svg')} type="image/svg+xml" />
  <ClientRouter />
  <script is:inline>
    /* runs before paint so a chosen theme never flashes the other one */
    try { var t = localStorage.getItem('theme'); if (t) document.documentElement.setAttribute('data-theme', t); } catch (e) {}
    /* view transitions swap <html> attributes, so put the choice back after each one */
    document.addEventListener('astro:after-swap', function () {
      try { var t = localStorage.getItem('theme'); if (t) document.documentElement.setAttribute('data-theme', t); } catch (e) {}
    });
  </script>
</head>
<body data-line={line || undefined}>
  <a class="skip" href="#main">{t('Skip to content')}</a>
  <header class="topbar">
    <div class="wrap topbar__in">
      <a class="brand" href={href('')} aria-current={current === 'home' ? 'page' : undefined}>Light Platinum <em>DS</em></a>
      <nav class="nav" aria-label={t('Sections')}>
        {LINES.map((l) => (
          <ul class="nav__group" style={`--lc:var(--line-${l.key})`} aria-label={t(l.label)}>
            {l.sections.map((s) => (
              <li><a href={href(s.path)} aria-current={current === s.key ? 'page' : undefined}>{t(s.label)}</a></li>
            ))}
          </ul>
        ))}
      </nav>
      <div class="topbar__tools">
        {/* the language switch: the same page, in the other language */}
        <div class="lang" role="group" aria-label="Language · Idioma">
          <a href={enUrl} hreflang="en" lang="en" aria-current={es ? undefined : 'true'} title="English">EN</a>
          <a href={esUrl} hreflang="es" lang="es" aria-current={es ? 'true' : undefined} title="Español">ES</a>
        </div>
        <button class="signbtn" type="button" popovertarget="find" aria-label={t('Search the guide')} title={t('Search')}>
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="9" cy="9" r="6"/><path d="m14 14 4 4"/></svg>
        </button>
        <button class="signbtn signbtn--theme" type="button" data-theme-toggle aria-label={t('Switch colour theme')} title={t('Light / dark')}>
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
            <circle cx="10" cy="10" r="4"/><path d="M10 2v2M10 16v2M2 10h2M16 10h2M4.3 4.3l1.4 1.4M14.3 14.3l1.4 1.4M4.3 15.7l1.4-1.4M14.3 5.7l1.4-1.4"/>
          </svg>
        </button>
        <button class="signbtn signbtn--menu" type="button" popovertarget="menu" aria-label={t('All sections')} title={t('All sections')}>
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 5.5h14M3 10h14M3 14.5h14"/></svg>
        </button>
      </div>
    </div>
  </header>

  {/* the whole network on one sheet: four lines, their sections, one tap each */}
  <div class="sheet" id="menu" popover>
    <nav class="menu" aria-label={t('All sections')}>
      {LINES.map((l) => (
        <section class="menu__line" style={`--lc:var(--line-${l.key})`}>
          <h2 class="linehead">{t(l.label)}</h2>
          <ul>
            {l.sections.map((s) => (
              <li><a href={href(s.path)} aria-current={current === s.key ? 'page' : undefined}>{t(s.label)}</a></li>
            ))}
          </ul>
        </section>
      ))}
    </nav>
    {/* on a phone the theme switch lives here, so the bar has room for the language switch */}
    <button class="btn menu__theme" type="button" data-theme-toggle>
      <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="10" cy="10" r="4"/><path d="M10 2v2M10 16v2M2 10h2M16 10h2M4.3 4.3l1.4 1.4M14.3 14.3l1.4 1.4M4.3 15.7l1.4-1.4M14.3 5.7l1.4-1.4"/></svg>
      {t('Light / dark')}
    </button>
  </div>

  <div class="sheet sheet--find" id="find" popover data-search>
    <label class="field field--big">
      <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="9" cy="9" r="6"/><path d="m14 14 4 4"/></svg>
      <input type="search" placeholder={t('A place, Pokémon, item, medal…')} aria-label={t('Search the guide')} autocomplete="off" />
    </label>
    <ul class="results" data-results hidden></ul>
  </div>

  <main id="main" class="wrap" transition:animate="fade">
    <slot />
  </main>

  <footer class="foot">
    <div class="wrap">
      <p set:html={rich('A fan guide to <1>Pokémon Light Platinum DS</1> (v0.2.2). Not affiliated with Nintendo, Game Freak or The Pokémon Company.', { 1: '<strong>' })} />
      <p set:html={rich('Species sprites via <1>PokeAPI</1>.', { 1: '<a href="https://github.com/PokeAPI/sprites">' })} />
    </div>
  </footer>

  {/* the Spanish for sentences that scripts put on the page */}
  {es && <script type="application/json" id="i18n" set:html={JSON.stringify(clientDict())} />}

  <script>
    import { wireSearch } from '../scripts/search.js';

    const wire = () => {
      wireSearch();

      /* opening the search sheet puts the cursor in its box */
      const find = document.getElementById('find');
      if (find && !find.dataset.focusWired) {
        find.dataset.focusWired = '1';
        find.addEventListener('toggle', (e) => { if (e.newState === 'open') find.querySelector('input')?.focus(); });
      }

      /* theme switch; persists, and survives view transitions */
      for (const btn of document.querySelectorAll('[data-theme-toggle]')) {
        if (btn.dataset.wired) continue;
        btn.dataset.wired = '1';
        btn.addEventListener('click', () => {
          const root = document.documentElement;
          const dark = root.getAttribute('data-theme') === 'dark'
            || (!root.getAttribute('data-theme') && matchMedia('(prefers-color-scheme: dark)').matches);
          const next = dark ? 'light' : 'dark';
          root.setAttribute('data-theme', next);
          try { localStorage.setItem('theme', next); } catch (e) {}
        });
      }
    };
    wire();
    document.addEventListener('astro:page-load', wire);

    /* "/" opens search from anywhere, unless you are already typing */
    document.addEventListener('keydown', (e) => {
      if (e.key !== '/' || e.altKey || e.ctrlKey || e.metaKey) return;
      if (/^(INPUT|TEXTAREA|SELECT)$/.test(document.activeElement?.tagName || '')) return;
      const find = document.getElementById('find');
      if (find?.showPopover) { e.preventDefault(); find.showPopover(); }
    });
  </script>
</body>
</html>
