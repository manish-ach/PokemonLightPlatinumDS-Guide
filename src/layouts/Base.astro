---
import '@fontsource-variable/ibm-plex-sans';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { href } from '../lib/data.js';

interface Props { title: string; description?: string; current?: string; }
const { title, description = 'A field guide to Pokémon Light Platinum DS.', current = '' } = Astro.props;

const NAV = [
  ['places', 'Places', 'places/'],
  ['dex', 'Dex', 'dex/'],
  ['gyms', 'Gyms', 'gyms/'],
  ['items', 'Items', 'items/'],
  ['medals', 'Medals', 'medals/'],
  ['quests', 'Quests', 'quests/'],
  ['sun', 'Sun Palace', 'sun-palace/'],
  ['gifts', 'Mystery Gift', 'gifts/'],
  ['trades', 'Trades', 'trades/'],
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title} · Light Platinum DS</title>
  <meta name="description" content={description} />
  <link rel="icon" href={href('favicon.svg')} type="image/svg+xml" />
  <ClientRouter />
  <script is:inline>
    /* runs before paint so a chosen theme never flashes the other one */
    try { var t = localStorage.getItem('theme'); if (t) document.documentElement.setAttribute('data-theme', t); } catch (e) {}
    /* view transitions swap <html> attributes, so put the choice back after each one */
    document.addEventListener('astro:after-swap', function () {
      try { var t = localStorage.getItem('theme'); if (t) document.documentElement.setAttribute('data-theme', t); } catch (e) {}
    });
  </script>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="topbar">
    <div class="wrap topbar__in">
      <a class="brand" href={href('')}>Light Platinum <em>DS</em></a>
      <nav class="nav" aria-label="Sections">
        {NAV.map(([key, label, path]) => (
          <a href={href(path)} aria-current={current === key ? 'page' : undefined}>{label}</a>
        ))}
      </nav>
      <button class="iconbtn" type="button" data-theme-toggle aria-label="Switch colour theme" title="Light / dark">
        <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
          <circle cx="10" cy="10" r="4"/><path d="M10 2v2M10 16v2M2 10h2M16 10h2M4.3 4.3l1.4 1.4M14.3 14.3l1.4 1.4M4.3 15.7l1.4-1.4M14.3 5.7l1.4-1.4"/>
        </svg>
      </button>
    </div>
  </header>

  <main id="main" class="wrap" transition:animate="fade">
    <slot />
  </main>

  <footer class="foot">
    <div class="wrap">
      <p>A fan guide to <strong>Pokémon Light Platinum DS</strong> (v0.2.2). Not affiliated with Nintendo, Game Freak or The Pokémon Company.</p>
      <p>Species sprites via <a href="https://github.com/PokeAPI/sprites">PokeAPI</a>.</p>
    </div>
  </footer>

  <script>
    /* theme switch; persists, and survives view transitions */
    const wire = () => {
      const btn = document.querySelector('[data-theme-toggle]');
      if (!btn || btn.dataset.wired) return;
      btn.dataset.wired = '1';
      btn.addEventListener('click', () => {
        const root = document.documentElement;
        const dark = root.getAttribute('data-theme') === 'dark'
          || (!root.getAttribute('data-theme') && matchMedia('(prefers-color-scheme: dark)').matches);
        const next = dark ? 'light' : 'dark';
        root.setAttribute('data-theme', next);
        try { localStorage.setItem('theme', next); } catch (e) {}
      });
    };
    wire();
    document.addEventListener('astro:page-load', wire);
  </script>
</body>
</html>
